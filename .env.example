VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
# Nur Root-URL, ohne Pfad (kein /emails am Ende):
VITE_FIREBASE_DATABASE_URL=https://YOUR_PROJECT_ID-default-rtdb.europe-west1.firebasedatabase.app
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Der Datenbankpfad ist nicht mehr einstellbar: jeder Benutzer hat seinen
# eigenen Bereich unter users/<uid>/. Die Regeln in database.rules.json
# erlauben nur den Zugriff auf den eigenen.

# --- KI-Suche (Vercel Serverless Function /api/gemini-search) ---
# In Vercel (Serverless /api): GEMINI_API_KEY und Projekt-ID.
# FIREBASE_PROJECT_ID=...  (oder nur VITE_FIREBASE_PROJECT_ID – API nutzt das als Fallback)
# GEMINI_API_KEY=...       (alternativ: GOOGLE_GENERATIVE_AI_API_KEY)
# Optional: GEMINI_MODEL=gemini-3.1-flash-lite-preview
#
# Lokal mit `npx vercel dev -l 3000` und Vite-Proxy:
# VITE_API_BASE_URL=http://127.0.0.1:3000

# --- Email-Proxy: Postfächer und Mail-Abholung ---
# Der Email-Proxy (eigenes Repo) hält die IMAP-/SMTP-Zugangsdaten aller
# Postfächer. HabMail kennt nur URL und Keys — hier liegt kein Mailpasswort.
#
# WICHTIG: Der Admin-Key des Proxys gehört NICHT hierher. Er darf alles, auch
# die Postfächer aller anderen Projekte lesen und löschen. HabMail benutzt
# einen gewöhnlichen Client-Key mit zwei Befugnissen:
#   node scripts/emailproxy-admin.mjs client:create --id habmail
#   node scripts/emailproxy-admin.mjs client:own-mailboxes --id habmail
#   node scripts/emailproxy-admin.mjs client:receive --id habmail
#
# In Vercel (für /api/mailboxes, damit die Postfach-Verwaltung im UI läuft):
# EMAILPROXY_URL=https://dein-proxy.vercel.app
# EMAILPROXY_KEY=ep_...
#
# In den Firebase Functions (für das geplante Abholen), zu setzen mit
#   firebase functions:secrets:set EMAILPROXY_KEY
# oder als Umgebungsvariable der Function:
# EMAILPROXY_URL=https://dein-proxy.vercel.app
# EMAILPROXY_KEY=ep_...        derselbe Key
# GEMINI_API_KEY=...           kategorisiert die abgeholten Mails
# GEMINI_MODEL=gemini-3.1-flash-lite-preview
#
# Die allerersten Administratoren, kommagetrennt. Ohne die käme niemand an die
# Benutzerverwaltung heran. Danach reicht der Eintrag unter admins/<uid> in der
# Datenbank — das Migrationsskript setzt ihn für dich.
# ADMIN_UIDS=<deine-firebase-uid>
#
# Höchstens so viele Mails je Postfach und Lauf (Default 25).
# POLL_MESSAGE_LIMIT=25
# Anhänge über dieser Größe landen nur als Name/Größe in der Datenbank
# (Default 1 MB) — Base64 in der RTDB ist teuer.
# MAX_INLINE_ATTACHMENT_BYTES=1048576
#
# Schützt den Ingest-Endpunkt (n8n & Co. müssen den Wert dann als
# "Authorization: Bearer <token>" mitschicken). Ohne die Variable nimmt der
# Endpunkt weiterhin von jedem Daten an.
# INGEST_TOKEN=...
# Schaltet das manuelle Auslösen von pollMailboxesNow frei.
# POLL_TRIGGER_TOKEN=...

# --- E-Mail-Versand ---
# Antworten und Weiterleiten laufen über den Email-Proxy, aus dem Postfach, in
# dem die Mail angekommen ist. Es braucht dafür KEINE eigenen SMTP-Variablen
# mehr — EMAILPROXY_URL und EMAILPROXY_KEY von oben genügen.
#
# Falls in Vercel noch SMTP_HOST/SMTP_USER/SMTP_PASS stehen: die werden nicht
# mehr gelesen und können weg.
