{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",

        "mailFolders": {
          "$folderId": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "!newData.exists() || (newData.hasChild('name') && newData.child('name').isString() && newData.child('name').val().length > 0 && newData.child('name').val().length <= 120)"
          }
        },

        "emails": {
          "$emailId": {
            ".write": "auth != null && auth.uid === $uid && !newData.exists()",

            "folderId": {
              ".write": "auth != null && auth.uid === $uid",
              ".validate": "!newData.exists() || newData.isString() || newData.val() == null"
            },
            "userRead": {
              ".write": "auth != null && auth.uid === $uid",
              ".validate": "newData.isBoolean()"
            },

            "period": {
              ".write": "auth != null && auth.uid === $uid",
              ".validate": "!newData.exists() || newData.val().matches(/^[0-9]{4}-[0-9]{2}$/)"
            },

            "invoice": {
              ".write": "auth != null && auth.uid === $uid",
              "amountCents": {
                ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 0)"
              },
              "currency": {
                ".validate": "!newData.exists() || (newData.isString() && newData.val().length == 3)"
              },
              "invoiceNumber": {
                ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 60)"
              },
              "issuedOn": {
                ".validate": "!newData.exists() || newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)"
              },
              "dueOn": {
                ".validate": "!newData.exists() || newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)"
              },
              "vendor": {
                ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 120)"
              }
            }
          }
        }
      }
    },

    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      }
    },

    "userDirectory": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true"
    }
  }
}
